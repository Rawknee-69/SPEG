{
  "name": "@cacm/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the CACM daemon (cross-agent context memory) over WebSocket",
  "keywords": [
    "cacm",
    "context",
    "cross-agent",
    "memory",
    "sdk",
    "websocket"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "npm run build && tsc -p tsconfig.test.json",
    "test": "npm run build && node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
